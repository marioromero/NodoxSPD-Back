###
# 38. Buscar por ID específico
GET https://spd-service.nodox.cl/api/company/policies?id={{policy_web_id}}
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

###
# 39. Filtro combinado: tipo + estado
GET https://spd-service.nodox.cl/api/company/policies?type=privacy_policy&status=published
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

###
# 40. Archivar una política publicada
PATCH https://spd-service.nodox.cl/api/company/policies/{{policy_cookie_id}}/archive
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

###
# 41. Eliminar (hard delete) una política archivada
DELETE https://spd-service.nodox.cl/api/company/policies/{{policy_cookie_id}}
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

###
# 42. Error esperado: intentar actualizar una política publicada (403)
PUT https://spd-service.nodox.cl/api/company/policies/{{policy_web_id}}
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

{
    "wizard_data": { "hacked": true }
}


