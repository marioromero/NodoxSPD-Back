###
# 5. Obtener Catálogo de Plantillas (Ahora vendrán filtradas según el Paso 4)
GET https://spd-service.nodox.cl/api/company/legal-templates
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

###
# 6. Iniciar Wizard: Crear el "Cascarón" Vacío (Borrador de Política Web)
POST https://spd-service.nodox.cl/api/company/policies
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

{
    "document_type": "privacy_policy"
}

> {%
    // Capturamos el ID del borrador recién creado
    if (response.status === 201) {
        client.global.set("policy_web_id", response.body.data.id);
    }
%}

###
# 7. Autoguardado Paso 1: El usuario llena los primeros datos (Formato plano)
PUT https://spd-service.nodox.cl/api/company/policies/{{policy_web_id}}
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

{
    "wizard_data": {
        "step_1_website_functions_informative": true,
        "step_1_website_functions_ecommerce": true,
        "step_1_website_functions_saas": false
    }
}

###
# 8. Autoguardado Final: El usuario termina todos los pasos (Merge profundo lo une con el Paso 1)
PUT https://spd-service.nodox.cl/api/company/policies/{{policy_web_id}}
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

{
    "wizard_data": {
        "step_2_sensitive_data_salud": true,
        "step_2_health_basis": "medical_care",
        "step_2_sensitive_data_biometria": false,
        "step_6_retention_tax_commercial": true,
        "step_6_retention_user_accounts": true,
        "step_6_retention_account_days": 30
    }
}

###
# 9. Previsualizar el HTML generado (Antes de firmar)
