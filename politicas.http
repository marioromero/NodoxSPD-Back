# ==============================================================================
# DOCUMENTO LEGAL PERSONALIZADO - FLUJO COMPLETO
# ==============================================================================
#
# ESTRUCTURA DEL WIZARD (3 PASOS):
#
# Paso 1 - Clasificación legal:
#   custom_policy_title: text
#   custom_policy_is_privacy_related: boolean
#
# Paso 2 - Redacción libre (show_if: is_privacy_related = false):
#   custom_policy_free_text_html: text (HTML libre)
#
# Paso 3 - Parámetros Ley 21.719 (show_if: is_privacy_related = true):
#   custom_policy_context: text
#   custom_policy_data_categories: text
#   custom_policy_purposes: text
#   custom_policy_legal_basis: text
#   custom_policy_recipients: text
#   custom_policy_international_transfers: text
#   custom_policy_retention_period: text
# ==============================================================================

