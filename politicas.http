# ==============================================================================
# NODOX SPD - Archivo de Pruebas HTTP para el Frontend
# ==============================================================================
# Este archivo documenta TODOS los endpoints y los payloads wizard_data que
# el frontend debe enviar. Los campos multiselect se envían como arrays JSON.
# Los campos show_if se envían solo cuando la condición se cumple.
#
# CONVENCIÓN DE TIPOS DEL WIZARD:
#   boolean  → true / false
#   text     → "string"
#   multiselect → ["opcion1", "opcion2"]  (array de strings)
#   number   → 30
#
# IMPORTANTE: LiteSpeed no reenvía el body en PATCH.
#   Usar POST con header: X-HTTP-Method-Override: PATCH
#   O usar PUT para autoguardado.
# ==============================================================================


# ==============================================================================
# AUTENTICACIÓN
# ==============================================================================

###
# 1. Obtener cookie CSRF + Token + Sesión
GET https://spd-service.nodox.cl/sanctum/csrf-cookie
Accept: application/json
Origin: https://localhost:8000

> {%
    let cookies = response.headers.valuesOf("Set-Cookie");
    for (let cookie of cookies) {
        if (cookie.startsWith("XSRF-TOKEN=")) {
            let rawToken = cookie.split(";")[0].substring(11);
            client.global.set("xsrf_token", decodeURIComponent(rawToken));
        }
        if (cookie.startsWith("nodoxspd-session=")) {
            let rawSession = cookie.split(";")[0].substring(17);
            client.global.set("session_cookie", rawSession);
        }
    }
%}

###
# 2. Login
POST https://spd-service.nodox.cl/api/login
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

{
    "email": "contacto_qa_final@empresa.com",
    "password": "SecretPassword123",
    "type": "company"
}

> {%
    let cookies = response.headers.valuesOf("Set-Cookie");
    for (let cookie of cookies) {
        if (cookie.startsWith("XSRF-TOKEN=")) {
            let rawToken = cookie.split(";")[0].substring(11);
            client.global.set("xsrf_token", decodeURIComponent(rawToken));
        }
        if (cookie.startsWith("nodoxspd-session=")) {
            let rawSession = cookie.split(";")[0].substring(17);
            client.global.set("session_cookie", rawSession);
        }
    }
%}


# ==============================================================================
# TRIAGE (CONFIGURACIÓN INICIAL DE MÓDULOS)
# ==============================================================================

###
# 3. Obtener preguntas del Triage para "Políticas"
GET https://spd-service.nodox.cl/api/company/triage-questions?module=policies
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

###
# 4. Responder Triage (habilita los templates según las respuestas)
PATCH https://spd-service.nodox.cl/api/company/legal-settings
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

{
    "module_slug": "policies",
    "answers": {
        "has_employees": true,
        "has_digital_presence": true
    }
}


