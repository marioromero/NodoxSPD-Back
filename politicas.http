Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}


# ==============================================================================
# POLÍTICA DE PRIVACIDAD WEB - FLUJO COMPLETO
# ==============================================================================
#
# ESTRUCTURA DEL WIZARD (6 PASOS):
#
# Paso 1 - Funciones de la plataforma:
#   step_1_website_functions: multiselect ["informativa","ecommerce","saas"]
#
# Paso 2 - Datos sensibles:
#   step_2_sensitive_data: multiselect ["salud","biometria","politica","sindical","religion","sexual","racial","otros","ninguna"]
#   step_2_sensitive_data_other: text (show_if: sensitive_data contiene "otros")
#
# Paso 3 - Menores de edad:
#   step_3_minors_active: boolean
#   step_3_minors_purposes: multiselect ["servicio","seguridad","legal","marketing","otros"] (show_if: minors_active=true)
#   step_3_minors_other_purpose: text (show_if: minors_purposes contiene "otros")
#   step_3_minors_verification_method: text (show_if: minors_active=true)
#
# Paso 4 - Proveedores y terceros:
#   step_4_providers: multiselect ["local","google_analytics","meta","shopify","wix","squarespace","mailchimp","hubspot","salesforce","aws","azure","google_cloud","otros"]
#   step_4_other_provider: text (show_if: providers contiene "otros")
#
# Paso 5 - Inteligencia artificial:
#   step_5_ai_active: boolean
#   step_5_ai_logic: text (show_if: ai_active=true)
#
# Paso 6 - Plazos de retención:
#   step_6_retention: multiselect ["tributario","cuentas","marketing","personalizado"]
#   step_6_retention_account_days: text (show_if: retention contiene "cuentas")
#   step_6_retention_custom_period: text (show_if: retention contiene "personalizado")
# ==============================================================================

###
# 6. Crear borrador de Política de Privacidad Web
POST https://spd-service.nodox.cl/api/company/policies
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

{
    "document_type": "privacy_policy"
}

> {%
    if (response.status === 201) {
        client.global.set("policy_web_id", response.body.data.id);
    }
%}

###
# 7. Autoguardado Paso 1 - Funciones de la plataforma
#    multiselect: enviar como array JSON
PUT https://spd-service.nodox.cl/api/company/policies/{{policy_web_id}}
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

{
    "wizard_data": {
        "step_1_website_functions": ["informativa", "ecommerce"]
    }
}

###
# 8. Autoguardado Paso 2 - Datos sensibles
#    multiselect + texto condicional
PUT https://spd-service.nodox.cl/api/company/policies/{{policy_web_id}}
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

{
    "wizard_data": {
        "step_2_sensitive_data": ["salud", "biometria", "otros"],
        "step_2_sensitive_data_other": "Datos genéticos"
    }
}

###
# 9. Autoguardado Paso 3 - Menores de edad
#    boolean + multiselect + texto condicional
PUT https://spd-service.nodox.cl/api/company/policies/{{policy_web_id}}
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

{
    "wizard_data": {
        "step_3_minors_active": true,
        "step_3_minors_purposes": ["servicio", "marketing"],
        "step_3_minors_verification_method": "Firma en libro de visitas con RUN del tutor"
    }
}

###
# 10. Autoguardado Paso 4 - Proveedores y terceros
#     multiselect + texto condicional
PUT https://spd-service.nodox.cl/api/company/policies/{{policy_web_id}}
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

{
    "wizard_data": {
        "step_4_providers": ["local", "google_analytics", "aws", "otros"],
        "step_4_other_provider": "Cloudflare Inc. (EE.UU.) - CDN y Seguridad"
    }
}

###
# 11. Autoguardado Paso 5 - Inteligencia artificial
#     boolean + texto condicional
PUT https://spd-service.nodox.cl/api/company/policies/{{policy_web_id}}
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

{
    "wizard_data": {
        "step_5_ai_active": true,
        "step_5_ai_logic": "Algoritmo de scoring crediticio basado en historial financiero y variables de comportamiento"
    }
}

###
# 12. Autoguardado Paso 6 - Plazos de retención
#     multiselect + textos condicionales
PUT https://spd-service.nodox.cl/api/company/policies/{{policy_web_id}}
Content-Type: application/json
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

{
    "wizard_data": {
        "step_6_retention": ["tributario", "cuentas", "marketing", "personalizado"],
        "step_6_retention_account_days": "30",
        "step_6_retention_custom_period": "2 años desde la última interacción"
    }
}

###
# 13. Previsualizar HTML generado (antes de publicar)
GET https://spd-service.nodox.cl/api/company/policies/{{policy_web_id}}/render
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

###
# 14. Publicar (firmar y sellar inmutabilidad)
POST https://spd-service.nodox.cl/api/company/policies/{{policy_web_id}}/publish
Accept: application/json
Origin: https://localhost:8000
X-XSRF-TOKEN: {{xsrf_token}}
Cookie: nodoxspd-session={{session_cookie}}

> {%
    if (response.body.data && response.body.data.integrity_hash) {
        client.global.set("policy_integrity_hash", response.body.data.integrity_hash);
    }
%}

###
# 15. Vista pública de la política publicada (compartir/incrustar)
GET https://spd-service.nodox.cl/api/public/policies/{{policy_integrity_hash}}
Accept: text/html
Origin: https://localhost:8000


# ==============================================================================
# POLÍTICA DE COOKIES - FLUJO COMPLETO
# ==============================================================================
#
# ESTRUCTURA DEL WIZARD (4 PASOS):
#
# Paso 1 - Cookies Estrictamente Necesarias:
#   (Se inyecta automáticamente, sin wizard)
#
# Paso 2 - Analítica y Medición:
#   step_2_analytics_active: boolean
#   step_2_analytics_providers: multiselect ["google_analytics","hotjar_clarity","mixpanel_amplitude","otros"] (show_if: analytics_active=true)
#   step_2_analytics_other_provider: text (show_if: analytics_providers contiene "otros")
#
# Paso 3 - Publicidad y Rastreo:
#   step_3_marketing_active: boolean
#   step_3_marketing_providers: multiselect ["meta_pixel","google_ads","tiktok_linkedin","otros"] (show_if: marketing_active=true)
#   step_3_marketing_other_provider: text (show_if: marketing_providers contiene "otros")
#
# Paso 4 - Funcionalidad y Personalización:
#   step_4_functionality_active: boolean
#   step_4_functionality_providers: multiselect ["chats","multimedia","maps","otros"] (show_if: functionality_active=true)
#   step_4_functionality_other_provider: text (show_if: functionality_providers contiene "otros")
# ==============================================================================

