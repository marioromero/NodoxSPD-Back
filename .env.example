# Mail — Producción (Resend recomendado para MVP)
MAIL_MAILER=resend
RESEND_KEY=re_xxxxxxxxxxxx

# Mail — Desarrollo local (mantener log para no gastar cuota)
# MAIL_MAILER=log

MAIL_FROM_ADDRESS="noreply@tudominio.com"
MAIL_FROM_NAME="Nombre del SaaS"

